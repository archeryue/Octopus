# Octopus Configuration
OCTOPUS_AUTH_TOKEN=changeme
# The handle the sidebar shows. Never the token — that row is on screen
# permanently, so a token there is in every screenshot and screen share.
OCTOPUS_USER_LABEL=octopus
OCTOPUS_HOST=0.0.0.0
OCTOPUS_PORT=8000
OCTOPUS_DEFAULT_WORKING_DIR=.
OCTOPUS_CORS_ORIGINS=["http://localhost:5173"]
